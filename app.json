{
  "scripts": {
    "dokku": {
      "predeploy": "python apps/application/manage.py migrate --noinput && python apps/application/manage.py createcachetable"
    }
  },
  "cron": [
    {
      "command": "python apps/application/manage.py refresh_weather",
      "schedule": "30 0 * * *"
    },
    {
      "command": "python apps/application/manage.py cleanup_weather",
      "schedule": "30 1 * * *"
    },
    {
      "command": "python apps/application/manage.py check_nightly_update --retry",
      "schedule": "30 2 * * *"
    },
    {
      "command": "python apps/application/manage.py check_nightly_update --retry",
      "schedule": "15 3 * * *"
    },
    {
      "command": "python apps/application/manage.py check_nightly_update",
      "schedule": "0 4 * * *"
    }
  ],
  "healthchecks": {
    "web": [
      {
        "type": "startup",
        "name": "web check",
        "path": "/health/",
        "attempts": 3,
        "timeout": 5,
        "wait": 5
      }
    ]
  }
}
